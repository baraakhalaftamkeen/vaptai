# Copy to .env and fill in. NEVER commit a real .env.
# Backend
# Local/dev default: zero-setup SQLite (tables auto-create, admin auto-seeds).
VAPT_DATABASE_URL=sqlite:///./vapt_v2_dev.db
# Full stack (docker compose): comment the line above and use MariaDB instead:
# VAPT_DATABASE_URL=mysql+pymysql://vapt:change-me@mariadb:3306/vapt_v2
VAPT_REDIS_URL=redis://localhost:6379/0
VAPT_SESSION_TTL_HOURS=12
VAPT_COOKIE_SECURE=false            # set true behind TLS
# Comma-separated (a JSON array also works). Kept quote-free so sourcing .env in bash
# doesn't mangle it.
VAPT_CORS_ORIGINS=http://localhost:3000

# First-run bootstrap admin (rotate immediately after first login)
VAPT_BOOTSTRAP_ADMIN_USER=admin
VAPT_BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-run

# Compose-only secrets
VAPT_DB_PASSWORD=change-me
VAPT_DB_ROOT_PASSWORD=change-me-root
VAPT_MINIO_USER=vaptminio
VAPT_MINIO_PASSWORD=change-me-minio

# LLM gateway
# provider: "ollama" (native API) or "openai" (ANY OpenAI-compatible server:
# vLLM, llama.cpp, LM Studio, TGI, or Ollama's own /v1 endpoint).
VAPT_LLM_PROVIDER=ollama
VAPT_LLM_BASE_URL=http://localhost:11434
VAPT_LLM_MODEL=
VAPT_LLM_TIMEOUT_S=60
# Permitted data classes for this endpoint. Keep local-only engagement content off
# any hosted profile — fallback must never widen data permissions.
VAPT_LLM_DATA_CLASSES=standard
# Name of the env var holding the key, not the key itself. Local servers need none.
VAPT_LLM_API_KEY_ENV=LLM_KEY
# The actual secret. .env is gitignored — never put this in a committed script.
LLM_KEY=
# OPENAI_API_KEY=            # only if a hosted profile is enabled

# Scanner binaries. The broker resolves each tool by name on PATH; set an explicit
# absolute path here when PATH is ambiguous (e.g. a venv shadows ProjectDiscovery's
# httpx with the Python httpx CLI) or the tool lives outside PATH. A tool whose binary
# is absent is reported as a coverage gap, never faked. Leave blank to use PATH.
VAPT_HTTPX_BIN=/home/pt-team/go/bin/httpx
VAPT_DNSX_BIN=/home/pt-team/go/bin/dnsx
VAPT_TESTSSL_BIN=/opt/testssl.sh/testssl.sh
VAPT_ZAP_BASELINE_BIN=
# PoC request shim (ships in the repo). Point it at workers/bin/vapt-burp, and set
# BURP_PROXY to Burp's Proxy listener. Only used when an engagement opts into exploitation.
# In-band web probe (open redirect / path traversal / SSRF-local / sensitive data / XXE); make it executable (chmod +x workers/bin/vapt-web-probe)
VAPT_WEB_PROBE_BIN=/home/pt-team/Desktop/VAPT-AI/vapt-ai-v2/workers/bin/vapt-web-probe
VAPT_BURP_BIN=/home/pt-team/Desktop/VAPT-AI/vapt-ai-v2/workers/bin/vapt-burp
BURP_PROXY=http://127.0.0.1:8080
# Optional free NVD API key (https://nvd.nist.gov/developers/request-an-api-key). Raises
# the NVD rate limit from 5 to 50 requests/30s — recommended for the CPE fallback matcher.
# Everything works without it, just slower / more likely to be rate-limited.
VAPT_NVD_API_KEY=

# --- External authenticated-scanner intel (optional) -----------------------------------
# Tenable.sc live, READ-ONLY. Set all three to enable the tenable_scan ingestion step; it
# pulls your existing Tenable.sc findings for each in-scope host and folds them in as
# confirmed (corroborating the active scan). Leave any blank to disable Tenable entirely.
VAPT_TENABLE_URL=
VAPT_TENABLE_ACCESS_KEY=
VAPT_TENABLE_SECRET_KEY=
# Shim binaries (make them executable: chmod +x workers/bin/vapt-tenable workers/bin/vapt-nessus-import)
VAPT_TENABLE_BIN=/home/pt-team/Desktop/VAPT-AI/vapt-ai-v2/workers/bin/vapt-tenable
VAPT_NESSUS_BIN=/home/pt-team/Desktop/VAPT-AI/vapt-ai-v2/workers/bin/vapt-nessus-import
# Optional: a workspace-relative .nessus export to import on every run (offline, no Tenable.sc).
VAPT_NESSUS_FILE=

# --- Pentest-tool catalog (packages/tools/vapt_tools/catalog.py) -----------------------
# ~65 extra governed tools across all five phases. A tool whose binary isn't on PATH simply
# no-ops (honest coverage gap). Override any one binary with VAPT_<ID>_BIN (id upper-cased,
# '-'→'_'), e.g. VAPT_SQLMAP_BIN=/opt/sqlmap/sqlmap.py . Run `python3 scripts/check_tools.py`
# to see what's installed vs missing. Default wordlist for content-discovery tools:
VAPT_WORDLIST=/usr/share/seclists/Discovery/Web-Content/common.txt
