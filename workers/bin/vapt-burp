#!/usr/bin/env python3
"""vapt-burp — bounded PoC evidence capture through Burp Suite's proxy.

The attack agent proposes a single `burp_request` action against a CONFIRMED finding;
after human approval the broker runs this shim argv-only (no shell). It issues ONE
read/request-only HTTP(S) request routed through Burp's proxy listener, so the request
lands in Burp's proxy history / sitemap (the evidence), and prints a bounded JSON summary
of the response to stdout — which the orchestrator links to the finding as PoC evidence.

It never modifies the target (GET/HEAD only), never captures more than a short response
excerpt, and exits non-zero if Burp's proxy can't be reached (so the platform records an
honest coverage gap instead of a fake PoC).

Config:
  BURP_PROXY   proxy URL (default http://127.0.0.1:8080) — Burp's Proxy listener.
  Burp's MITM CA is not trusted here by design: TLS verification is disabled so the
  proxied HTTPS request succeeds; this tool only reads a response, never credentials.
"""
from __future__ import annotations

import argparse
import json
import os
import ssl
import sys
import urllib.error
import urllib.request

_MAX_BODY = 400
_ALLOWED_METHODS = {"GET", "HEAD"}


def _run(url: str, method: str) -> int:
    method = method.upper()
    if method not in _ALLOWED_METHODS:
        print(json.dumps({"ok": False, "url": url, "error": f"method {method} not allowed (read-only)"}))
        return 2

    proxy = os.environ.get("BURP_PROXY", "http://127.0.0.1:8080")
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE  # accept Burp's MITM cert; we only read a response
    opener = urllib.request.build_opener(
        urllib.request.ProxyHandler({"http": proxy, "https": proxy}),
        urllib.request.HTTPSHandler(context=ctx),
    )
    req = urllib.request.Request(url, method=method, headers={"User-Agent": "VAPT-AI/BurpPoC"})
    try:
        resp = opener.open(req, timeout=20)
        body = resp.read(_MAX_BODY)
        out = {
            "ok": True, "via": "burp", "proxy": proxy, "url": url, "method": method,
            "status": getattr(resp, "status", resp.getcode()),
            "server": resp.headers.get("Server", ""),
            "content_type": resp.headers.get("Content-Type", ""),
            "excerpt": body.decode("latin-1", "replace")[:_MAX_BODY],
        }
        print(json.dumps(out))
        return 0
    except urllib.error.HTTPError as e:
        # An HTTP error status is still a real, proxied response — valid evidence.
        print(json.dumps({"ok": True, "via": "burp", "proxy": proxy, "url": url,
                          "method": method, "status": e.code, "note": "http error status"}))
        return 0
    except Exception as e:  # proxy unreachable, DNS, timeout, etc. -> honest failure
        print(json.dumps({"ok": False, "via": "burp", "proxy": proxy, "url": url,
                          "error": f"{type(e).__name__}: {e}"}))
        return 2


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="vapt-burp", description="Bounded PoC request via Burp proxy")
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("request", help="issue one read-only request through Burp")
    r.add_argument("--url", required=True)
    r.add_argument("--method", default="GET")
    args = ap.parse_args(argv)
    if args.cmd == "request":
        return _run(args.url, args.method)
    ap.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
