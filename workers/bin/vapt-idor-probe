#!/usr/bin/env python3
"""Deterministic IDOR (Insecure Direct Object Reference) probe — v3.0.

Owner-vs-non-owner model
------------------------
Real-world IDOR on object references (orders, invoices, receipts, bookings)
usually keys the object by an UNGUESSABLE token (a 32-char hex / UUID), not a
sequential integer. The vuln is: user B can read user C's object simply by
holding C's token. The tell is NOT that two users see *different* bodies at the
same URL (the old v2 heuristic) — it is the OPPOSITE: a non-owner sees the SAME
body the owner sees. v2 inverted this and missed every token-based IDOR
(DineHub's /order?id=<hex> among them).

v3 strategy:
  1. Load every available authenticated session (A/B/C cookies from Redis).
  2. HARVEST: for each user, fetch their object-LISTING pages (e.g. /orders)
     and extract the object-reference URLs that belong to THEM (hrefs like
     /order?id=<tok>, /order/track/<tok>, /invoice/<tok>, …). Because each
     user's listing shows only their own objects, this establishes OWNERSHIP.
  3. CROSS-ACCESS: for each object URL owned by user X, request it as every
     OTHER user Y. If Y gets a 200 whose body is substantially similar to what
     owner X sees (and is real content, not a login/denied/empty page, and not
     the same thing an unauthenticated client gets) → confirmed IDOR: Y read
     X's private object.

Legacy numeric enumeration is kept as a secondary mode: for a seeded URL with a
numeric id, rewrite it to an adjacent id and check whether a second account can
read the neighbour.

Public per-resource pages (/restaurant/*/menu, /products/*, …) are skipped:
every user is supposed to see them, so they are never IDOR candidates.

Emits ONE JSON record to stdout:
    {"findings": [{"type": "idor"|"idor_delete", "severity": "high"|"critical",
                   "url", "param", "method"?, "evidence", "confirmed": true}, ...],
     "trace":    [{"url", "status", "note"}, ...]}

Safety: GET-only in read mode, bounded request budget, in-scope-only URLs,
argv-only. Delete mode uses POST/DELETE but ONLY against destructive-action
endpoints (order/delete, order/cancel, …) — never against object-view URLs.

Delete mode (--mode delete)
---------------------------
Targets destructive endpoints: /order/delete, /order/cancel, etc. For each
such endpoint, sends a POST (or DELETE) request as a NON-owner with the
owner's object ID in the body (or query). If the response indicates success
(200/302, no denial markers) while an anonymous request is denied, that
confirms a cross-tenant destructive IDOR. This catches the pattern where
GET-based IDOR is patched but POST delete/cancel actions lack authz.
"""
from __future__ import annotations

import argparse
import difflib
import base64
import json
import os
import re
import sys
from itertools import zip_longest
from urllib.parse import urljoin, urlparse, parse_qsl, urlencode, urlunparse

try:
    import requests
except Exception as e:
    print(json.dumps({"error": f"requests not available: {e}", "findings": []}))
    sys.exit(0)

_UA = "vapt-idor-probe/3.1 (authorized assessment)"
_TIMEOUT = 10
_BUDGET = 1500
_MIN_BODY = 400          # a real object page is substantial; below this is a stub/denied
_SIM_HIT = 0.90          # non-owner body this similar to owner's = same object served

# Numeric ID in a path segment: /42, /123/, /42?… etc. (legacy enumeration mode).
_PATH_ID_RE = re.compile(r"/(\d{1,10})(?=/|\?|$)")

# An object TOKEN: long hex (>=16), a UUID, or a short integer. Used both to
# recognise object-reference URLs and to decide a path segment is an id.
_TOKEN_RE = re.compile(
    r"[0-9a-f]{16,}"                                   # long hex (order tokens)
    r"|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"  # uuid
    r"|\d{1,10}",                                      # short integer
    re.IGNORECASE,
)

# Query-param names that typically carry an object id/token.
_ID_PARAM_NAMES = frozenset({
    "id", "oid", "uid", "pid", "ref", "num", "token", "uuid", "guid",
    "object", "object_id",
})
_ID_PARAM_SUFFIX_RE = re.compile(r"(?:_id|Id|ID)$")

# Dynamic: any /<word>/<token-or-id> is an object URL unless it matches a known
# public-catalog prefix. No hardcoded noun list — works for any app.
_OBJECT_PATH_RE = re.compile(
    r"/([a-zA-Z][a-zA-Z0-9_-]{1,30})"
    r"(?:/track)?/(?:[0-9a-f]{8,}|[0-9a-f-]{32,}|\d{1,10})(?:[/?]|$)",
    re.IGNORECASE,
)

# Action-verb suffix in a path: /<noun>/<id>/<ACTION>.  When an IDOR is
# confirmed on an action URL, the probe follows up on sibling view endpoints
# (e.g. /order/<id>/receipt) that may now be accessible after the state change.
_ACTION_SUFFIX_RE = re.compile(
    r"/(?:archive|claim|transfer|assign|approve|accept|activate|"
    r"cancel|close|complete|confirm|delete|disable|dismiss|enable|"
    r"escalate|finalize|flag|grant|lock|merge|move|publish|"
    r"redeem|reject|release|remove|resolve|restore|revoke|"
    r"submit|suspend|unlock|update|verify|withdraw)/?$",
    re.IGNORECASE,
)

# Common view/detail suffixes to try as siblings after an action IDOR.
_VIEW_SUFFIXES = (
    "receipt", "detail", "details", "view", "show", "info",
    "summary", "invoice", "report", "data", "content", "download",
    "export", "preview", "print", "pdf", "status", "history",
)


# Custom HTTP headers commonly used as identity selectors.  When an endpoint
# trusts one of these to override session identity, it is a header-based IDOR.
_IDENTITY_HEADERS = (
    "X-UserId", "X-User-Id", "X-User-ID", "X-UserID",
    "X-Account-Id", "X-AccountId", "X-Account-ID",
    "X-Auth-User-Id", "X-Auth-UserId", "X-Auth-User",
    "X-Forwarded-User", "X-Forwarded-User-Id",
    "User-Id", "UserId", "Account-Id",
)

# Common authenticated-page paths to test for header IDOR.
_AUTH_PAGE_PATHS = (
    "/dashboard", "/profile", "/account", "/home", "/me",
    "/settings", "/my-account", "/user", "/admin", "/panel",
)


def _sibling_urls(action_url: str, seed_urls: list[str], target: str) -> list[str]:
    """Given an action URL like /order/300198/archive, return sibling view URLs
    for the same object ID, derived from seed URLs and common suffixes.

    General strategy:
      1. Parse the base pattern: /order/300198/ (strip the action suffix)
      2. Find other known suffixes from seed URLs with the same noun prefix
      3. Add common view suffixes as fallback candidates
    """
    try:
        parsed = urlparse(action_url)
        path = parsed.path.rstrip("/")
    except Exception:
        return []

    # Strip the action suffix to get /<noun>/<id>
    parts = path.rsplit("/", 1)
    if len(parts) < 2:
        return []
    base_path = parts[0]  # e.g. /order/300198

    # Extract the noun prefix (e.g. "order" from /order/300198)
    base_parts = base_path.strip("/").split("/")
    if len(base_parts) < 2:
        return []
    noun = base_parts[0].lower()

    # Collect known suffixes from seed URLs with the same noun
    known_suffixes: set[str] = set()
    for u in seed_urls:
        try:
            sp = urlparse(u).path.rstrip("/")
        except Exception:
            continue
        sp_parts = sp.strip("/").split("/")
        if len(sp_parts) >= 3 and sp_parts[0].lower() == noun:
            suffix = sp_parts[-1].lower()
            if suffix and not re.fullmatch(r"\d+|[0-9a-f-]{8,}", suffix):
                known_suffixes.add(suffix)

    # Merge with common view suffixes (seed-discovered first)
    all_suffixes = list(known_suffixes) + [s for s in _VIEW_SUFFIXES
                                            if s not in known_suffixes]

    base = f"{parsed.scheme}://{parsed.netloc}"
    siblings: list[str] = []
    for suffix in all_suffixes:
        url = f"{base}{base_path}/{suffix}"
        if _in_scope(target, url) and url != action_url:
            siblings.append(url)

    # Also try the bare base path (e.g. /order/300198) as a detail page
    bare = f"{base}{base_path}"
    if _in_scope(target, bare) and bare != action_url and bare not in siblings:
        siblings.insert(0, bare)

    return siblings


# Fallback listing paths when seed URLs don't provide enough collection prefixes.
_FALLBACK_LISTING_PATHS = (
    "/account", "/dashboard", "/profile", "/history",
)

def _listing_paths_from_seeds(seed_urls: list[str]) -> tuple[str, ...]:
    """Derive listing (collection) paths from discovered seed URLs dynamically.
    E.g. /allocations/2 → /allocations, /order/track/abc → /order.
    Also treats bare collection URLs (/orders, /invoices) as listing paths."""
    collections: list[str] = []
    seen: set[str] = set()
    _bare_collection_re = re.compile(
        r"^/[a-zA-Z][a-zA-Z0-9_-]{1,30}/?$", re.IGNORECASE)
    for u in seed_urls:
        try:
            path = urlparse(u).path or ""
        except Exception:
            continue
        m = _OBJECT_PATH_RE.search(path)
        if m:
            prefix = "/" + m.group(1)
            low = prefix.lower()
            if low not in seen:
                seen.add(low)
                collections.append(prefix)
        elif _bare_collection_re.match(path):
            low = path.rstrip("/").lower()
            if low not in seen:
                seen.add(low)
                collections.append(path.rstrip("/"))
    for p in _FALLBACK_LISTING_PATHS:
        if p.lower() not in seen:
            seen.add(p.lower())
            collections.append(p)
    return tuple(collections)

# PUBLIC per-resource pages — never IDOR candidates (every user sees the same).
_PUBLIC_DATA_RE = re.compile(
    r"/(?:restaurant|restaurants|product|products|category|categories|"
    r"catalog|menu|item|items|post|posts|article|articles|page|pages|"
    r"blog|news|review|reviews)s?(?:/\d+)?(?:/[^?]*)?$",
    re.IGNORECASE,
)

# Markers that a response is an access-denied / login / not-found page rather
# than real object content.
_DENIED_RE = re.compile(
    r"not\s+authori[sz]ed|unauthori[sz]ed|forbidden|access\s+denied|"
    r"permission\s+denied|please\s+log\s*in|login\s+required|sign\s+in|"
    r"not\s+found|does\s+not\s+exist|no\s+such\s+order|invalid\s+order",
    re.IGNORECASE,
)
_LOGIN_FORM_RE = re.compile(r"""<input\b[^>]*\btype\s*=\s*["']password["']""", re.IGNORECASE)


def _in_scope(target_host: str, url: str) -> bool:
    try:
        return urlparse(url).hostname == target_host
    except Exception:
        return False


def _is_public_data(url: str) -> bool:
    try:
        parsed = urlparse(url)
        if any(p[0].lower() in _ID_PARAM_NAMES for p in parse_qsl(parsed.query)):
            return False  # an explicit id param overrides the public-prefix skip
        return bool(_PUBLIC_DATA_RE.search(parsed.path or ""))
    except Exception:
        return False


def _looks_like_object_url(url: str) -> bool:
    """True when the URL references a specific per-user object (by token/id),
    i.e. a real IDOR candidate — not a public catalog page, not a bare listing."""
    if _is_public_data(url):
        return False
    try:
        parsed = urlparse(url)
    except Exception:
        return False
    # Query-param id/token (e.g. /order?id=<hex>, /view?allocation_id=3)
    for name, value in parse_qsl(parsed.query, keep_blank_values=True):
        nl = name.lower()
        if (nl in _ID_PARAM_NAMES or _ID_PARAM_SUFFIX_RE.search(name)) \
                and value and _TOKEN_RE.fullmatch(value):
            return True
    # Object path with a token/id (e.g. /order/track/<hex>, /invoice/42)
    if _OBJECT_PATH_RE.search(parsed.path or ""):
        return True
    return False


def _redis_cookies(run_id: str) -> dict[str, str]:
    """Load every per-account session cookie available (A=admin, B=user1, C=user2)."""
    if not run_id:
        return {}
    try:
        import redis
        r = redis.Redis.from_url(
            os.environ.get("VAPT_REDIS_URL", "redis://localhost:6379/0"),
            socket_timeout=3,
        )
        out: dict[str, str] = {}
        for slot in ("A", "B", "C"):
            v = r.get(f"vapt:webcookie:{run_id}:{slot}")
            if v:
                out[slot] = v.decode() if isinstance(v, bytes) else str(v)
        return out
    except Exception:
        return {}


def _users(cookies: dict[str, str]) -> list[tuple[str, str]]:
    """Ordered (label, cookie) for every present session. Prefer the two normal
    users (B, C) first so cross-tenant comparisons avoid admin-only noise, with
    admin (A) last as an extra actor."""
    order = [("user1", "B"), ("user2", "C"), ("admin", "A")]
    return [(label, cookies[slot]) for label, slot in order if cookies.get(slot)]


def _session(cookie: str) -> "requests.Session":
    s = requests.Session()
    s.headers.update({"User-Agent": _UA, "Accept": "*/*"})
    if cookie:
        s.headers["Cookie"] = cookie
    return s


def _get(sess, url, budget_box):
    if budget_box[0] <= 0:
        return None
    budget_box[0] -= 1
    try:
        return sess.get(url, timeout=_TIMEOUT, allow_redirects=False)
    except Exception:
        return None


def _get_with_headers(sess, url, extra_headers, budget_box):
    """Like _get() but injects additional HTTP headers into the request."""
    if budget_box[0] <= 0:
        return None
    budget_box[0] -= 1
    try:
        return sess.get(url, timeout=_TIMEOUT, allow_redirects=False,
                        headers=extra_headers)
    except Exception:
        return None


def _strip_html(html: str) -> str:
    """Extract visible text from HTML, stripping scripts, styles, and tags."""
    text = re.sub(r'<script[^>]*>.*?</script>', ' ', html or '',
                  flags=re.DOTALL | re.IGNORECASE)
    text = re.sub(r'<style[^>]*>.*?</style>', ' ', text,
                  flags=re.DOTALL | re.IGNORECASE)
    text = re.sub(r'<[^>]+>', ' ', text)
    return re.sub(r'\s+', ' ', text).strip()


def _extract_page_ids(html: str) -> set[str]:
    """Extract numeric IDs from HTML that might be user/account identifiers."""
    ids: set[str] = set()
    if not html:
        return ids
    for m in re.finditer(
        r'(?:user_id|userId|user\.id|user-id|account_id|accountId|'
        r'profile_id|member_id|client_id)\s*[:=]\s*["\']?(\d{1,10})',
        html, re.I):
        ids.add(m.group(1))
    for m in re.finditer(
        r'"(?:id|user_id|userId|account_id|profileId)"\s*:\s*"?(\d{1,10})"?',
        html, re.I):
        ids.add(m.group(1))
    for m in re.finditer(
        r'data-[\w-]*(?:user|account|profile|member)?-?id\s*=\s*["\'](\d{1,10})["\']',
        html, re.I):
        ids.add(m.group(1))
    # Nearby number after identity keywords (within 100 chars) — catches
    # <input name="user_id" ... value="10032"> patterns.
    for m in re.finditer(r'(?:user_id|userId|user-id|user\.id)', html, re.I):
        window = html[m.end():m.end()+100]
        for n in re.finditer(r'(\d{3,10})', window):
            ids.add(n.group(1))
            break
    return ids


def _ids_from_cookie(cookie_str: str) -> set[str]:
    """Extract numeric user IDs embedded in session cookies.

    Many frameworks encode the user identity directly in the cookie value:
      - Flask session:  base64(json).signature  → {"user_id": 10032}
      - JWT:            header.base64(payload).signature → {"sub": "10032", "uid": 42}
      - Plain value:    userId=10032

    Extracting these gives the probe a starting point for offset enumeration
    even when no IDs appear in page HTML or seed URLs.
    """
    ids: set[str] = set()
    if not cookie_str:
        return ids

    _id_key_re = re.compile(
        r'(?:user_id|userId|user-id|uid|sub|id|account_id|accountId'
        r'|user|identity|profile_id|member_id)'
        r'["\s:=]+["\']?(\d{1,10})', re.I)

    for part in cookie_str.split(";"):
        part = part.strip()
        if "=" not in part:
            continue
        _, value = part.split("=", 1)
        value = value.strip()

        # Direct numeric match (e.g. userId=10032)
        if re.fullmatch(r'\d{1,10}', value):
            ids.add(value)

        # Try decoding base64 segments (Flask session, JWT payload)
        segments = value.split(".")
        for seg in segments[:3]:
            try:
                padded = seg + "=" * (4 - len(seg) % 4)
                decoded = base64.urlsafe_b64decode(padded).decode("utf-8", "ignore")
                for m in _id_key_re.finditer(decoded):
                    ids.add(m.group(1))
            except Exception:
                pass

    return ids


def _pw_in_nav_or_header(body: str) -> bool:
    """True when the <input type=password> lives inside <nav> or <header>
    (a nav-bar login widget), not in the page's main content area."""
    m = _LOGIN_FORM_RE.search(body)
    if not m:
        return False
    low = body[:m.start()].lower()
    if low.rfind("<nav") > low.rfind("</nav"):
        return True
    if low.rfind("<header") > low.rfind("</header"):
        return True
    return False


def _is_real_content(resp) -> bool:
    """True when the response is substantive object content, not a denial/login/stub."""
    if resp is None or resp.status_code != 200:
        return False
    body = resp.text or ""
    if len(body) < _MIN_BODY:
        return False
    if _DENIED_RE.search(body):
        return False
    if _LOGIN_FORM_RE.search(body) and not _pw_in_nav_or_header(body):
        return False
    return True


def _similar(a: str, b: str) -> float:
    return difflib.SequenceMatcher(None, (a or "")[:6000], (b or "")[:6000]).ratio()


def _bases_from_urls(target: str, urls: list[str]) -> list[str]:
    """Distinct scheme://netloc bases (in scope) seen across the seed URLs."""
    bases: list[str] = []
    for u in urls:
        try:
            p = urlparse(u)
        except Exception:
            continue
        if p.hostname != target:
            continue
        base = f"{p.scheme}://{p.netloc}"
        if base not in bases:
            bases.append(base)
    return bases


def _extract_object_urls(html: str, base: str, target: str) -> list[str]:
    """Pull object-reference URLs (href/action) out of a listing page.

    Also extracts data-*-id attributes (e.g. data-order-id="300123") and
    derives object URLs from the page's JavaScript AJAX patterns. This catches
    SPA-style apps where receipt/detail endpoints are loaded via JS, not hrefs
    (XBEN-001-24 Trading Platform: data-order-id + $.ajax /order/<id>/receipt).
    """
    out: list[str] = []
    for m in re.finditer(r"""(?:href|action)\s*=\s*["']([^"']+)["']""", html or "",
                         re.IGNORECASE):
        raw = m.group(1).strip()
        if not raw or raw.startswith(("#", "javascript:", "mailto:")):
            continue
        url = raw if raw.lower().startswith(("http://", "https://")) \
            else urljoin(base + "/", raw.lstrip("/"))
        if not _in_scope(target, url):
            continue
        if _looks_like_object_url(url) and url not in out:
            out.append(url)

    # Extract data-*-id attributes and try to derive object URLs from JS patterns.
    # Pattern: data-order-id="300123" → look for AJAX url patterns like /order/<id>/receipt
    _data_id_re = re.compile(
        r"""data-([a-zA-Z][\w-]*)-id\s*=\s*["'](\d{1,10}|[0-9a-f]{8,}|[0-9a-f-]{32,})["']""",
        re.IGNORECASE,
    )
    _ajax_url_re = re.compile(
        r"""["'](/[a-zA-Z][\w-]*/\s*['"]\s*\+|url:\s*["']/([a-zA-Z][\w-]*)/)|"""
        r"""['"]/([\w-]+)/['"]\s*\+\s*\w+Id""",
        re.IGNORECASE,
    )
    data_ids: list[tuple[str, str]] = []  # (noun, id)
    for m in _data_id_re.finditer(html or ""):
        noun = m.group(1).replace("-", "").lower()
        obj_id = m.group(2)
        data_ids.append((noun, obj_id))

    if data_ids:
        # Try to find AJAX URL patterns in scripts to build full URLs.
        # Common patterns: '/order/' + orderId + '/receipt'
        _js_path_re = re.compile(
            r"""["'](/(\w+)/["']\s*\+\s*\w+\s*\+\s*["']/(\w+))""",
        )
        js_paths: list[tuple[str, str]] = []  # (noun_prefix, suffix)
        for m in _js_path_re.finditer(html or ""):
            js_paths.append((m.group(2).lower(), m.group(3)))

        for noun, obj_id in data_ids:
            # Direct: /<noun>/<id> (e.g. /order/300123)
            direct = urljoin(base + "/", f"{noun}/{obj_id}")
            if _in_scope(target, direct) and direct not in out:
                if _looks_like_object_url(direct):
                    out.append(direct)
            # With JS-discovered suffixes (e.g. /order/300123/receipt)
            for js_noun, suffix in js_paths:
                if js_noun == noun or js_noun in noun or noun in js_noun:
                    full = urljoin(base + "/", f"{js_noun}/{obj_id}/{suffix}")
                    if _in_scope(target, full) and full not in out:
                        out.append(full)

    return out


def _harvest(users, bases, target, budget_box, trace, listing_paths):
    """Return {object_url: owner_label} by visiting each user's listing pages and
    attributing every object URL found there to that user (first owner wins)."""
    owned: dict[str, str] = {}
    for label, cookie in users:
        sess = _session(cookie)
        seen_pages = 0
        for base in bases:
            for path in listing_paths:
                if budget_box[0] <= 0 or seen_pages >= 8:
                    break
                r = _get(sess, base + path, budget_box)
                if r is None:
                    continue
                seen_pages += 1
                if r.status_code != 200 or not r.text:
                    trace.append({"url": base + path, "status": r.status_code,
                                  "note": f"{label} listing (skip)"})
                    continue
                found = _extract_object_urls(r.text, base, target)
                for u in found:
                    owned.setdefault(u, label)
                if found:
                    trace.append({"url": base + path, "status": 200,
                                  "note": f"{label} owns {len(found)} object url(s)"})
    return owned


def _cross_access(users, owned, budget_box, trace, seed_urls=(), target=""):
    """For each owned object URL, check whether a NON-owner can read it."""
    findings: list[dict] = []
    # Unauthenticated baseline session (no cookie) to rule out public objects.
    anon = _session("")
    for url, owner in owned.items():
        owner_cookie = dict(users).get(owner)
        if not owner_cookie:
            continue
        owner_resp = _get(_session(owner_cookie), url, budget_box)
        if not _is_real_content(owner_resp):
            trace.append({"url": url, "status": getattr(owner_resp, "status_code", None),
                          "note": f"owner {owner}: no baseline content (skip)"})
            continue
        owner_body = owner_resp.text
        # Public check: an anonymous client getting the same content means it is
        # not access-controlled at all — report separately, not as cross-tenant.
        anon_resp = _get(anon, url, budget_box)
        anon_same = _is_real_content(anon_resp) and _similar(owner_body, anon_resp.text) >= _SIM_HIT
        for ylabel, ycookie in users:
            if ylabel == owner:
                continue
            ysess = _session(ycookie)
            yr = _get(ysess, url, budget_box)
            if not _is_real_content(yr):
                trace.append({"url": url, "status": getattr(yr, "status_code", None),
                              "note": f"{ylabel} denied/empty (good)"})
                continue
            sim = _similar(owner_body, yr.text)
            trace.append({"url": url, "status": yr.status_code,
                          "note": f"{ylabel} 200 sim={sim:.2f} vs owner {owner}"})
            if sim >= _SIM_HIT:
                body_snippet = (yr.text or "")[:2000]
                evidence = (f"non-owner '{ylabel}' retrieved object owned by "
                            f"'{owner}' (HTTP 200, body sim={sim:.2f} to owner's "
                            f"view) — cross-tenant object access"
                            f"\n\nResponse body (first 2000 chars):\n{body_snippet}")
                severity = "high"
                if anon_same:
                    evidence += ("; object is ALSO readable with NO authentication "
                                 "(leaks to anonymous clients) — missing access control")
                    severity = "critical"

                # Post-action sibling probing (same as single-account mode)
                parsed_path = urlparse(url).path.rstrip("/")
                if _ACTION_SUFFIX_RE.search(parsed_path):
                    siblings = _sibling_urls(url, list(seed_urls), target)
                    for sib_url in siblings[:10]:
                        if budget_box[0] <= 0:
                            break
                        sr = _get(ysess, sib_url, budget_box)
                        if sr is None:
                            continue
                        if sr.status_code == 200 and len(sr.text or "") >= _MIN_BODY \
                                and not _DENIED_RE.search(sr.text or ""):
                            sib_body = (sr.text or "")[:2000]
                            evidence += (f"\n\n--- sibling endpoint unlocked after action ---"
                                         f"\nURL: {sib_url} (HTTP 200, {len(sr.text)} bytes)"
                                         f"\nResponse body (first 2000 chars):\n{sib_body}")
                            trace.append({"url": sib_url, "status": 200,
                                          "note": f"sibling view after cross-tenant action IDOR"})

                findings.append({
                    "type": "idor", "severity": severity,
                    "url": url, "param": "object-token",
                    "evidence": evidence, "confirmed": True,
                })
                break  # one confirmation per object URL is enough
    return findings


def _rewrite_path_id(url: str, new_id: str) -> str:
    return _PATH_ID_RE.sub(f"/{new_id}", url, count=1)


def _rewrite_query_id(url: str, param: str, new_id: str) -> str:
    parsed = urlparse(url)
    pairs = parse_qsl(parsed.query, keep_blank_values=True)
    rewritten = [(k, (new_id if k.lower() == param.lower() else v)) for k, v in pairs]
    return urlunparse(parsed._replace(query=urlencode(rewritten)))


def _numeric_targets(url: str) -> list[tuple[str, str, str]]:
    """(kind, location, current_id) for each NUMERIC id in the URL (enumeration mode)."""
    out: list[tuple[str, str, str]] = []
    parsed = urlparse(url)
    for m in _PATH_ID_RE.finditer(parsed.path or ""):
        out.append(("path", "path-id", m.group(1)))
    for name, value in parse_qsl(parsed.query, keep_blank_values=True):
        nl = name.lower()
        if (nl in _ID_PARAM_NAMES or _ID_PARAM_SUFFIX_RE.search(name)) \
                and re.fullmatch(r"\d{1,10}", value or ""):
            out.append(("query", name, value))
    return out


def _enumerate(users, seed_urls, budget_box, trace):
    """Legacy numeric-enumeration mode: for a seeded URL with a numeric id, have
    the FIRST user fetch it, rewrite the id to a neighbour, and check whether a
    SECOND user can read that neighbour with substantively different content."""
    findings: list[dict] = []
    if len(users) < 2:
        return findings
    (_la, ca), (_lb, cb) = users[0], users[1]
    sa, sb = _session(ca), _session(cb)
    for url in seed_urls:
        if budget_box[0] <= 0:
            break
        if _is_public_data(url) or not _in_scope(urlparse(url).hostname or "", url):
            pass
        targets = _numeric_targets(url)
        if not targets:
            continue
        kind, loc, cur = targets[0]
        try:
            neighbour = str(int(cur) + 1)
        except Exception:
            continue
        alt = _rewrite_path_id(url, neighbour) if kind == "path" \
            else _rewrite_query_id(url, loc, neighbour)
        r_owner = _get(sa, alt, budget_box)   # does user A see object #(n+1)?
        if not _is_real_content(r_owner):
            continue
        r_other = _get(sb, alt, budget_box)   # can user B see the same object?
        if not _is_real_content(r_other):
            continue
        if _similar(r_owner.text, r_other.text) >= _SIM_HIT:
            body_snippet = (r_other.text or "")[:2000]
            findings.append({
                "type": "idor", "severity": "high",
                "url": alt, "param": (f"path-id→{neighbour}" if kind == "path"
                                      else f"?{loc}={neighbour}"),
                "evidence": (f"two accounts both read object id {neighbour} with "
                             f"identical content (enumerable IDOR)"
                             f"\n\nResponse body (first 2000 chars):\n{body_snippet}"),
                "confirmed": True,
            })
    return findings


def _single_account_enumerate(user_label, user_cookie, seed_urls, bases, target,
                              budget_box, trace, listing_paths):
    """Single-account IDOR enumeration: with only ONE account, fetch the user's
    listing pages to discover which object IDs belong to them, then probe nearby
    numeric IDs. If the user gets a 200 with real content on an ID that is NOT
    in their own listing, that's an IDOR (the app served someone else's object
    without checking ownership).

    This catches the common pattern where /order/<id>/receipt has auth (login
    required) but no authz (any logged-in user can read any order).
    """
    findings: list[dict] = []
    sess = _session(user_cookie)
    anon = _session("")

    # Harvest this user's own object URLs from listing pages.
    own_urls: set[str] = set()
    for base in bases:
        for path in listing_paths:
            if budget_box[0] <= 0:
                break
            r = _get(sess, base + path, budget_box)
            if r is None or r.status_code != 200 or not r.text:
                continue
            found = _extract_object_urls(r.text, base, target)
            own_urls.update(found)
            if found:
                trace.append({"url": base + path, "status": 200,
                              "note": f"{user_label} owns {len(found)} object url(s)"})

    # Also add seeded URLs that look like object references.
    for u in seed_urls:
        if _looks_like_object_url(u):
            own_urls.add(u)

    # For each owned URL with a numeric ID, probe nearby IDs (id-1, id+1, ...).
    # If we get a 200 with real content on an ID NOT in our listing, it's IDOR.
    own_ids_by_pattern: dict[str, set[int]] = {}  # {url_pattern: {known_int_ids}}
    probed: set[str] = set()

    for url in own_urls:
        targets = _numeric_targets(url)
        if not targets:
            continue
        kind, loc, cur_id = targets[0]
        if kind == "path":
            pattern = _PATH_ID_RE.sub("/{ID}", url, count=1)
        else:
            pattern = url
        try:
            own_ids_by_pattern.setdefault(pattern, set()).add(int(cur_id))
        except (ValueError, TypeError):
            pass

    def _probe_id(url, kind, loc, probe_int, pattern):
        """Probe a single numeric ID. Returns a finding dict or None."""
        probe_id = str(probe_int)
        if kind == "path":
            probe_url = _rewrite_path_id(url, probe_id)
        else:
            probe_url = _rewrite_query_id(url, loc, probe_id)
        if probe_url in probed:
            return None
        probed.add(probe_url)
        if probe_int in own_ids_by_pattern.get(pattern, set()):
            return None
        r_auth = _get(sess, probe_url, budget_box)
        if not _is_real_content(r_auth):
            return None
        r_anon = _get(anon, probe_url, budget_box)
        anon_sees = (_is_real_content(r_anon)
                     and _similar(r_auth.text, r_anon.text) >= _SIM_HIT)
        body_snippet = (r_auth.text or "")[:2000]
        evidence = (f"user '{user_label}' accessed object id {probe_id} at "
                    f"{probe_url} (HTTP 200, {len(r_auth.text)} bytes) — "
                    f"this object is NOT in the user's own listing, "
                    f"indicating missing authorization check"
                    f"\n\nResponse body (first 2000 chars):\n{body_snippet}")
        severity = "high"
        if anon_sees:
            evidence += ("; object is ALSO readable with NO authentication "
                         "— missing access control entirely")
            severity = "critical"

        # Post-action sibling probing: when an IDOR is confirmed on a
        # state-changing action URL (e.g. /order/<id>/archive), the action may
        # grant the caller access to sibling view endpoints for the same object
        # (e.g. /order/<id>/receipt). Probe those siblings and capture any data
        # the action unlocked — this is a general pattern across many apps.
        parsed_path = urlparse(probe_url).path.rstrip("/")
        if _ACTION_SUFFIX_RE.search(parsed_path):
            siblings = _sibling_urls(probe_url, list(own_urls) + seed_urls, target)
            sibling_cap = 10  # max sibling requests per confirmed action IDOR
            for sib_url in siblings[:sibling_cap]:
                if budget_box[0] <= 0:
                    break
                sr = _get(sess, sib_url, budget_box)
                if sr is None:
                    continue
                if sr.status_code == 200 and len(sr.text or "") >= _MIN_BODY \
                        and not _DENIED_RE.search(sr.text or ""):
                    sib_body = (sr.text or "")[:2000]
                    evidence += (f"\n\n--- sibling endpoint unlocked after action ---"
                                 f"\nURL: {sib_url} (HTTP 200, {len(sr.text)} bytes)"
                                 f"\nResponse body (first 2000 chars):\n{sib_body}")
                    trace.append({"url": sib_url, "status": 200,
                                  "note": f"sibling view after action IDOR on id {probe_id}"})

        trace.append({"url": probe_url, "status": 200,
                      "note": f"IDOR: {user_label} read non-owned id {probe_id}"})
        return {"type": "idor", "severity": severity,
                "url": probe_url,
                "param": (f"path-id→{probe_id}" if kind == "path"
                          else f"?{loc}={probe_id}"),
                "evidence": evidence, "confirmed": True,
                "_body": body_snippet}

    # Strategy 1 (gap enumeration): probe IDs IN BETWEEN known owned IDs.
    # Probes are interleaved round-robin across all gaps so budget is spent
    # evenly — this reaches deep into EVERY gap instead of exhausting budget
    # on the first one.
    _gap_probes = []
    _gap_meta = []
    for pattern, known_ids in own_ids_by_pattern.items():
        sorted_ids = sorted(known_ids)
        if len(sorted_ids) < 2:
            continue
        ref_url = ref_kind = ref_loc = None
        for url in own_urls:
            targets = _numeric_targets(url)
            if not targets:
                continue
            k, l, c = targets[0]
            p = _PATH_ID_RE.sub("/{ID}", url, count=1) if k == "path" else url
            if p == pattern:
                ref_url, ref_kind, ref_loc = url, k, l
                break
        if not ref_url:
            continue
        for i in range(len(sorted_ids) - 1):
            lo, hi = sorted_ids[i], sorted_ids[i + 1]
            gap = hi - lo
            if gap <= 1:
                continue
            if gap <= 200:
                probes = list(range(lo + 1, hi))
            else:
                step = max(1, gap // 50)
                probes = list(range(lo + 1, hi, step))
                probes += [lo + 1, lo + 2, hi - 1, hi - 2]
                probes = sorted(set(probes))
            probes = [p for p in probes if p not in known_ids]
            if probes:
                _gap_probes.append(probes)
                _gap_meta.append((ref_url, ref_kind, ref_loc, pattern))

    _stop_enum = False
    for round_ids in zip_longest(*_gap_probes):
        if budget_box[0] <= 0 or _stop_enum:
            break
        for gi, pid in enumerate(round_ids):
            if pid is None:
                continue
            if budget_box[0] <= 0:
                _stop_enum = True
                break
            ref_url, ref_kind, ref_loc, pat = _gap_meta[gi]
            f = _probe_id(ref_url, ref_kind, ref_loc, pid, pat)
            if f:
                f.pop("_body", None)
                findings.append(f)

    # Strategy 2 (fixed offsets): probe nearby IDs around each known ID.
    # Fallback when gap enumeration didn't find anything.
    if not findings:
        _OFFSETS = [-1, 1, -2, 2, -5, 5, -10, 10, -50, 50, -100, 100, -200, 200]
        for url in list(own_urls):
            if budget_box[0] <= 0:
                break
            targets = _numeric_targets(url)
            if not targets:
                continue
            kind, loc, cur_id = targets[0]
            try:
                cur_int = int(cur_id)
            except (ValueError, TypeError):
                continue
            pattern = _PATH_ID_RE.sub("/{ID}", url, count=1) if kind == "path" else url
            for offset in _OFFSETS:
                if budget_box[0] <= 0:
                    break
                f = _probe_id(url, kind, loc, cur_int + offset, pattern)
                if f:
                    f.pop("_body", None)
                    findings.append(f)

    return findings


def _header_idor_probe(users, seed_urls, bases, target, budget_box, trace):
    """Probe for header-based IDOR: test whether authenticated endpoints accept
    custom HTTP headers (like X-UserId) that override the session identity.

    Strategy:
      1. Identify authenticated pages (content differs auth vs anon).
      2. Collect candidate user IDs from pages, seed URLs, and offsets.
      3. Canary scan: try each identity header with an invalid ID to find
         which headers the app recognises (400, body change, echoed value).
      4. For active headers, try real IDs; if visible text changes → IDOR.
    """
    findings: list[dict] = []
    if not users or budget_box[0] < 50:
        return findings

    label, cookie = users[0]
    sess = _session(cookie)
    anon = _session("")

    # --- 1. Find authenticated pages ---
    candidate_paths: list[str] = list(_AUTH_PAGE_PATHS)
    for u in seed_urls:
        try:
            path = urlparse(u).path
        except Exception:
            continue
        if path and not _looks_like_object_url(u) and path not in candidate_paths:
            candidate_paths.append(path)

    auth_pages: list[tuple[str, str]] = []  # (url, baseline_body)
    all_ids: set[str] = set()

    _auth_page_debug: list[dict] = []
    for base in bases:
        for path in candidate_paths[:15]:
            if budget_box[0] < 30 or len(auth_pages) >= 5:
                break
            url = base + path
            r_auth = _get(sess, url, budget_box)
            if not _is_real_content(r_auth):
                _auth_page_debug.append({
                    "url": url,
                    "skip": "not_real_content",
                    "status": getattr(r_auth, "status_code", None),
                    "len": len(getattr(r_auth, "text", "") or ""),
                })
                continue
            r_anon = _get(anon, url, budget_box)
            if _is_real_content(r_anon) \
                    and _similar(r_auth.text, r_anon.text) >= _SIM_HIT:
                _auth_page_debug.append({
                    "url": url, "skip": "public_page",
                    "sim": round(_similar(r_auth.text, r_anon.text), 3),
                })
                continue  # public page — same for everyone
            auth_pages.append((url, r_auth.text))
            all_ids.update(_extract_page_ids(r_auth.text))
    if _auth_page_debug:
        trace.append({"note": "header-idor: auth-page candidates",
                      "details": _auth_page_debug[:10]})

    if not auth_pages:
        trace.append({"note": f"header-idor: no auth pages found "
                              f"(tried {len(bases)} base(s) × "
                              f"{min(len(candidate_paths), 15)} path(s), "
                              f"budget_left={budget_box[0]})"})
        return findings

    # --- 2. Collect candidate user IDs ---
    # From seed URL paths / query params
    for u in seed_urls:
        try:
            parsed = urlparse(u)
            for m in re.finditer(r"\d{2,10}", parsed.path or ""):
                all_ids.add(m.group())
            for _, v in parse_qsl(parsed.query):
                if re.fullmatch(r"\d{2,10}", v or ""):
                    all_ids.add(v)
        except Exception:
            pass

    # From session cookies (Flask, JWT, etc. embed user IDs)
    for _, ck in users:
        all_ids.update(_ids_from_cookie(ck))

    # Fetch non-object seed URLs to extract IDs (e.g. /password/test → user_id)
    fetched: set[str] = set()
    for u in seed_urls[:20]:
        if budget_box[0] < 30 or _looks_like_object_url(u):
            continue
        if u in fetched:
            continue
        fetched.add(u)
        r = _get(sess, u, budget_box)
        if r and r.status_code == 200 and r.text:
            all_ids.update(_extract_page_ids(r.text))

    # Expand with numeric offsets
    expanded: set[str] = set(all_ids)
    for pid in list(all_ids):
        try:
            n = int(pid)
            for off in (-1, 1, -2, 2, -5, 5, -10, 10, -20, 20, -50, 50):
                if 0 < n + off < 10_000_000:
                    expanded.add(str(n + off))
        except (ValueError, TypeError):
            pass

    if not expanded:
        trace.append({"note": "header-idor: no candidate IDs"})
        return findings

    trace.append({"note": f"header-idor: {len(auth_pages)} auth pages, "
                          f"{len(all_ids)} base IDs → {len(expanded)} candidates"})

    # --- 3. Probe headers on each auth page ---
    for page_url, baseline_body in auth_pages:
        if budget_box[0] < 20:
            break

        baseline_text = _strip_html(baseline_body)

        # Phase 1 — canary scan: find which headers the app recognises.
        canary = "99999999"
        active_headers: list[str] = []
        echo_headers: list[str] = []

        for hdr in _IDENTITY_HEADERS:
            if budget_box[0] <= 0:
                break
            r = _get_with_headers(sess, page_url, {hdr: canary}, budget_box)
            if r is None:
                continue
            if r.status_code != 200:
                active_headers.append(hdr)
                if canary in (r.text or ""):
                    echo_headers.append(hdr)
                    trace.append({"url": page_url,
                                  "note": f"header-idor: {hdr} echoed canary "
                                          f"(HTTP {r.status_code})"})
                continue
            probe_text = _strip_html(r.text or "")
            text_sim = _similar(baseline_text, probe_text)
            if text_sim < 0.995:
                active_headers.append(hdr)

        # Prioritise headers that echoed the canary, then others; fall back to
        # the first few common names if the canary triggered nothing.
        priority = echo_headers + [h for h in active_headers
                                   if h not in echo_headers]
        if not priority:
            priority = list(_IDENTITY_HEADERS[:5])

        # Phase 2 — real IDs: try valid user IDs with the prioritised headers.
        target_ids = sorted(
            expanded,
            key=lambda i: (i in baseline_body, len(i), i),
        )[:12]

        found = False
        for hdr in priority[:5]:
            if found or budget_box[0] < 5:
                break
            for tid in target_ids:
                if budget_box[0] <= 0:
                    break
                r = _get_with_headers(sess, page_url, {hdr: tid}, budget_box)
                if r is None or not _is_real_content(r):
                    continue
                probe_text = _strip_html(r.text or "")
                text_sim = _similar(baseline_text, probe_text)
                if text_sim < 0.98:
                    body_snippet = (r.text or "")[:2000]
                    evidence = (
                        f"Header-based IDOR: injecting '{hdr}: {tid}' on "
                        f"{page_url} returned a different user's data "
                        f"(text similarity to baseline: {text_sim:.2f}). "
                        f"The endpoint trusts the custom HTTP header to "
                        f"select user identity, bypassing session auth."
                        f"\n\nResponse body (first 2000 chars):\n{body_snippet}"
                    )
                    findings.append({
                        "type": "idor", "severity": "critical",
                        "url": page_url,
                        "param": f"header:{hdr}={tid}",
                        "evidence": evidence, "confirmed": True,
                    })
                    trace.append({
                        "url": page_url, "status": r.status_code,
                        "note": f"header-idor CONFIRMED: {hdr}={tid} "
                                f"sim={text_sim:.2f}"})
                    found = True
                    break

    return findings


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--target", required=True)
    ap.add_argument("--urls", default="",
                    help="comma-separated in-scope seed URLs (object + listing hints)")
    ap.add_argument("--mode", choices=("read", "delete"), default="read",
                    help="read = GET-based view IDOR (default); "
                         "delete = POST/DELETE destructive IDOR")
    args = ap.parse_args()
    target = args.target
    run_id = os.environ.get("VAPT_RUN_ID", "").strip()
    cookies = _redis_cookies(run_id)
    users = _users(cookies)
    if len(users) < 1:
        print(json.dumps({"error": "need at least one account cookie in redis",
                          "findings": []}))
        return 0

    seed_urls = [u.strip() for u in args.urls.split(",")
                 if u.strip().lower().startswith(("http://", "https://"))
                 and _in_scope(target, u.strip())]
    bases = _bases_from_urls(target, seed_urls) or []
    if not bases:
        # Fall back to deriving a base from the seed list host:port even if none
        # matched (shouldn't happen) — otherwise nothing to harvest.
        for u in seed_urls:
            p = urlparse(u)
            bases = [f"{p.scheme}://{p.netloc}"]
            break

    budget_box = [_BUDGET]
    trace: list[dict] = [{"accounts": ",".join(l for l, _ in users),
                          "mode": args.mode, "note": "sessions"}]

    listing_paths = _listing_paths_from_seeds(seed_urls)
    trace.append({"listing_paths": list(listing_paths),
                  "note": "derived from seed URLs"})

    if args.mode == "delete":
        if len(users) < 2:
            print(json.dumps({"error": "delete mode needs at least two accounts",
                              "findings": []}))
            return 0
        findings = _delete_probe(users, bases, target, seed_urls,
                                 budget_box, trace, listing_paths)
    elif len(users) >= 2:
        # Multi-account mode: cross-tenant comparison.
        # 1) Harvest each user's own object URLs from their listing pages (establishes ownership).
        owned = _harvest(users, bases, target, budget_box, trace, listing_paths)
        # 2) Also treat any seeded URL that already points at a specific object as a
        #    candidate — but we only know its owner if harvesting attributed it.
        for u in seed_urls:
            if _looks_like_object_url(u):
                owned.setdefault(u, _harvest_owner(users, u, budget_box, trace))

        owned = {u: o for u, o in owned.items() if o}  # keep only owner-attributed URLs

        findings = _cross_access(users, owned, budget_box, trace,
                                  seed_urls=seed_urls, target=target)

        # 3) Secondary: numeric enumeration on seeded numeric URLs (non-public).
        enum_seeds = [u for u in seed_urls if not _is_public_data(u) and _numeric_targets(u)]
        findings += _enumerate(users, enum_seeds, budget_box, trace)
    else:
        # Single-account mode: enumerate numeric IDs to find objects NOT in
        # the user's own listing (missing authorization check).
        label, cookie = users[0]
        trace.append({"note": f"single-account mode: {label} only"})
        findings = _single_account_enumerate(
            label, cookie, seed_urls, bases, target,
            budget_box, trace, listing_paths)

    # Header-based IDOR probing (runs in read mode, any number of accounts).
    if args.mode != "delete":
        findings += _header_idor_probe(users, seed_urls, bases, target,
                                        budget_box, trace)

    # De-dup findings by (type, url).
    seen = set()
    uniq = []
    for f in findings:
        key = (f["type"], f["url"])
        if key not in seen:
            seen.add(key)
            uniq.append(f)

    print(json.dumps({"findings": uniq, "trace": trace[:60]}))
    return 0


_DESTRUCTIVE_PATH_RE = re.compile(
    r"/(?:order|orders|invoice|invoices|receipt|receipts|booking|bookings|"
    r"ticket|tickets|reservation|reservations|payment|payments|transaction|"
    r"transactions|document|documents|report|reports|message|messages|"
    r"item|items|comment|comments|post|posts|account|accounts|"
    r"user|users|profile)"
    r"/(?:delete|cancel|remove|revoke|archive|close)"
    r"(?:/|$|\?)",
    re.IGNORECASE,
)

_DESTRUCTIVE_LISTING_PATHS = (
    "/order/delete", "/orders/delete", "/order/cancel", "/orders/cancel",
    "/user/delete", "/users/delete", "/account/delete", "/accounts/delete",
    "/profile/delete", "/item/delete", "/post/delete", "/comment/delete",
    "/booking/cancel", "/ticket/cancel", "/reservation/cancel",
    "/invoice/cancel", "/receipt/delete", "/message/delete",
)

_SUCCESS_RE = re.compile(
    r"success|deleted|cancelled|canceled|removed|archived|"
    r"has been (deleted|cancelled|canceled|removed)",
    re.IGNORECASE,
)


def _post_or_delete(sess, url, body, method, budget_box):
    if budget_box[0] <= 0:
        return None
    budget_box[0] -= 1
    try:
        if method == "DELETE":
            return sess.delete(url, data=body, timeout=_TIMEOUT,
                               allow_redirects=False)
        return sess.post(url, data=body, timeout=_TIMEOUT,
                         allow_redirects=False)
    except Exception:
        return None


def _destructive_success(resp) -> bool:
    if resp is None:
        return False
    if resp.status_code in (200, 302):
        if _DENIED_RE.search(resp.text or ""):
            return False
        if _LOGIN_FORM_RE.search(resp.text or "") \
                and not _pw_in_nav_or_header(resp.text or ""):
            return False
        return True
    return False


def _delete_probe(users, bases, target, seed_urls, budget_box, trace, listing_paths):
    """Cross-tenant destructive IDOR: can user B delete/cancel user A's object?"""
    findings: list[dict] = []
    if len(users) < 2:
        return findings

    owned = _harvest(users, bases, target, budget_box, trace, listing_paths)
    for u in seed_urls:
        if _looks_like_object_url(u):
            owned.setdefault(u, _harvest_owner(users, u, budget_box, trace))
    owned = {u: o for u, o in owned.items() if o}
    if not owned:
        trace.append({"note": "delete mode: no owned objects to test"})
        return findings

    anon = _session("")

    for obj_url, owner in owned.items():
        if budget_box[0] <= 0:
            break
        parsed = urlparse(obj_url)
        obj_id = None
        obj_param = None
        for name, value in parse_qsl(parsed.query, keep_blank_values=True):
            if name.lower() in _ID_PARAM_NAMES and value:
                obj_id = value
                obj_param = name
                break
        if not obj_id:
            segments = [s for s in (parsed.path or "").split("/") if s]
            if segments and _TOKEN_RE.fullmatch(segments[-1]):
                obj_id = segments[-1]
                obj_param = "id"
        if not obj_id:
            continue

        for base in bases:
            if budget_box[0] <= 0:
                break
            for dpath in _DESTRUCTIVE_LISTING_PATHS:
                if budget_box[0] <= 0:
                    break
                action_url = base.rstrip("/") + dpath
                if not _in_scope(target, action_url):
                    continue
                body = {obj_param or "id": obj_id}

                for method in ("POST", "DELETE"):
                    if budget_box[0] <= 0:
                        break
                    anon_resp = _post_or_delete(anon, action_url, body,
                                                method, budget_box)
                    if _destructive_success(anon_resp):
                        trace.append({"url": action_url, "method": method,
                                      "note": "anon succeeded — no auth at all"})
                        continue

                    for ylabel, ycookie in users:
                        if ylabel == owner:
                            continue
                        if budget_box[0] <= 0:
                            break
                        yr = _post_or_delete(_session(ycookie), action_url,
                                             body, method, budget_box)
                        if _destructive_success(yr):
                            evidence = (
                                f"non-owner '{ylabel}' sent {method} to "
                                f"{action_url} with {obj_param or 'id'}="
                                f"{obj_id} (owned by '{owner}') — got "
                                f"HTTP {yr.status_code} indicating success; "
                                f"cross-tenant destructive IDOR"
                            )
                            findings.append({
                                "type": "idor_delete",
                                "severity": "critical",
                                "url": action_url,
                                "param": obj_param or "id",
                                "method": method,
                                "evidence": evidence,
                                "confirmed": True,
                            })
                            trace.append({
                                "url": action_url, "method": method,
                                "status": yr.status_code,
                                "note": f"{ylabel} destructive IDOR confirmed"})
                            break
                        else:
                            trace.append({
                                "url": action_url, "method": method,
                                "status": getattr(yr, "status_code", None),
                                "note": f"{ylabel} denied (good)"})
    return findings


def _harvest_owner(users, url, budget_box, trace):
    """Attribute a specific object URL to whichever user can retrieve it as real
    content — used for seeded object URLs not found via a listing page. Returns a
    label or ''. Note: a seeded token typically belongs to the crawling session
    (often admin); harvesting from listings is preferred for clean ownership."""
    for label, cookie in users:
        r = _get(_session(cookie), url, budget_box)
        if _is_real_content(r):
            return label
    return ""


if __name__ == "__main__":
    raise SystemExit(main())
