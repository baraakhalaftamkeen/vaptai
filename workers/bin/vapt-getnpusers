#!/usr/bin/env python3
"""Thin wrapper: call impacket GetNPUsers with python3 (shebang fix)."""
import os, sys
_SCRIPT = "/usr/share/doc/python3-impacket/examples/GetNPUsers.py"
if not os.path.isfile(_SCRIPT):
    print(f"impacket GetNPUsers not found at {_SCRIPT}", file=sys.stderr)
    sys.exit(127)
sys.argv[0] = _SCRIPT
try:
    exec(open(_SCRIPT).read())
except ImportError as e:
    print(f"[-] ImportError running GetNPUsers: {e}", file=sys.stderr)
    print(f"    python={sys.executable} argv={sys.argv}", file=sys.stderr)
    sys.exit(1)
except SystemExit:
    raise
except Exception as e:
    print(f"[-] Error running GetNPUsers: {type(e).__name__}: {e}", file=sys.stderr)
    print(f"    python={sys.executable} argv={sys.argv}", file=sys.stderr)
    sys.exit(1)
