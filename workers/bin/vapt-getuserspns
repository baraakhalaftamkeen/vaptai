#!/usr/bin/env python3
"""Thin wrapper: call impacket GetUserSPNs with python3 (shebang fix)."""
import os, sys
_SCRIPT = "/usr/share/doc/python3-impacket/examples/GetUserSPNs.py"
if not os.path.isfile(_SCRIPT):
    print(f"impacket GetUserSPNs not found at {_SCRIPT}", file=sys.stderr)
    sys.exit(127)
sys.argv[0] = _SCRIPT
try:
    exec(open(_SCRIPT).read())
except ImportError as e:
    print(f"[-] ImportError running GetUserSPNs: {e}", file=sys.stderr)
    print(f"    python={sys.executable} argv={sys.argv}", file=sys.stderr)
    sys.exit(1)
except SystemExit:
    raise
except Exception as e:
    print(f"[-] Error running GetUserSPNs: {type(e).__name__}: {e}", file=sys.stderr)
    print(f"    python={sys.executable} argv={sys.argv}", file=sys.stderr)
    sys.exit(1)
